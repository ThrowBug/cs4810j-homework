# --- VLM provider (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://your-provider.example.com/v1
# Vision-capable model, spelled exactly as your provider lists it.
# The baseline numbers in README.md use qwen3.8-flash.
LLM_MODEL=qwen3.8-flash
# Set to true if your provider rejects response_format=json_schema
LLM_NO_STRUCTURED_OUTPUT=false

# Turn off browser-use telemetry
ANONYMIZED_TELEMETRY=false
